# =============================================================================
# Hostorio AI Chatbot — root Apache configuration (cPanel / shared hosting)
#
# Two jobs:
#   1. Deny direct web access to application internals.
#   2. Route every remaining request into public/index.php.
#
# This lets the package be uploaded straight into public_html (or a subfolder)
# on hosts where the document root cannot be changed to public/.
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve Authorization headers — some CGI/FastCGI setups strip them,
    # which would break the diagnostics endpoint's bearer token.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block direct access to application directories.
    RewriteRule ^(chat|config|context|core|database|knowledge|llm|storage|tools)/ - [F,L]

    # Block dotfiles (.env above all).
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Serve real *static assets* directly — the widget's JS and the demo page.
    #
    # Restricted to an extension allowlist rather than "any file that exists":
    # with the document root at the project root, a blanket rule would happily
    # serve /admin/AdminAuth.php or any other source file that is not covered by
    # the directory denials above.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule \.(css|js|mjs|map|html|png|jpe?g|gif|svg|ico|webp|woff2?|ttf)$ - [L]

    # When the document root is the project root instead, map /widget/* onto
    # public/widget/* so the embed URL is the same either way.
    RewriteRule ^widget/(.*)$ public/widget/$1 [L]

    # Belt and braces: never serve a PHP file out of the application directories
    # even if one of the rules above is edited later.
    RewriteRule ^(admin|api|integrations)/.+\.php$ - [F,L]

    # Everything else goes through the front controller.
    RewriteRule ^ public/index.php [L]
</IfModule>

# Belt and braces: deny the .env file even if mod_rewrite is unavailable.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Never list directory contents.
Options -Indexes

# Do not advertise the PHP version.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
