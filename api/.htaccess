# Deny direct access to PHP files in this directory.
# All legitimate requests are rewritten to public/index.php by the root .htaccess.

<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
