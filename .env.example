#==============================================================================
# Hostorio AI Chatbot — Environment Configuration
#
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. Keep it outside public_html if possible.
#==============================================================================

#------------------------------------------------------------------------------
# Application
#------------------------------------------------------------------------------
APP_NAME="Hostorio AI Chatbot"
APP_ENV=production          # production | development
APP_DEBUG=false             # true only on a staging/dev site
APP_URL=https://example.com
APP_TIMEZONE=UTC

# Random 32+ char string. Used for signing/session integrity.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

#------------------------------------------------------------------------------
# Application database (this chatbot's own tables: conversations, KB, logs)
# This is the ONLY database the app writes to.
#------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
DB_PREFIX=hoai_

#------------------------------------------------------------------------------
# WordPress database (READ-ONLY — knowledge base source)
# Leave DB name blank to disable the WordPress connector entirely.
# Recommended: create a MySQL user with SELECT-only privileges.
#------------------------------------------------------------------------------
WP_DB_HOST=localhost
WP_DB_PORT=3306
WP_DB_NAME=
WP_DB_USER=
WP_DB_PASS=
WP_DB_CHARSET=utf8mb4
WP_TABLE_PREFIX=wp_

#------------------------------------------------------------------------------
# WHMCS database (READ-ONLY — customer / service / ticket / billing context)
# Leave DB name blank to disable the WHMCS connector entirely.
# Recommended: create a MySQL user with SELECT-only privileges.
#------------------------------------------------------------------------------
WHMCS_DB_HOST=localhost
WHMCS_DB_PORT=3306
WHMCS_DB_NAME=
WHMCS_DB_USER=
WHMCS_DB_PASS=
WHMCS_DB_CHARSET=utf8mb4

#------------------------------------------------------------------------------
# LLM providers
# At least one is required. Claude is required for tool-calling features.
#------------------------------------------------------------------------------

# Anthropic (Claude) — best tool-calling reliability
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# DeepSeek — cheapest, OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI — optional fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Which provider handles a query when no rule matches: claude | deepseek | openai
DEFAULT_PROVIDER=deepseek

#------------------------------------------------------------------------------
# Outbound HTTP (LLM API calls)
#------------------------------------------------------------------------------
HTTP_TIMEOUT=60             # seconds — total request timeout
HTTP_CONNECT_TIMEOUT=10     # seconds — connection timeout
HTTP_MAX_RETRIES=2          # retries on network failure / 5xx

#------------------------------------------------------------------------------
# Rate limiting (per identity: customer id, or IP for guests)
#------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=20  # requests allowed per window
RATE_LIMIT_WINDOW=60        # window length in seconds

#------------------------------------------------------------------------------
# Logging
#------------------------------------------------------------------------------
LOG_LEVEL=info              # debug | info | warning | error
LOG_RETENTION_DAYS=30       # older log files are pruned automatically

#------------------------------------------------------------------------------
# Admin panel
#------------------------------------------------------------------------------
# Password hash for the admin panel (Phase 7).
# Generate with: php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=

#------------------------------------------------------------------------------
# Embeddings (optional — for semantic knowledge-base search)
#
# Anthropic has no embeddings endpoint, so this needs a provider that does.
# Leave the driver as `none` to run on MySQL full-text search alone, which
# handles a hosting FAQ well and needs no extra API key.
#
# Drivers: none | openai
#------------------------------------------------------------------------------
EMBEDDING_DRIVER=none
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
